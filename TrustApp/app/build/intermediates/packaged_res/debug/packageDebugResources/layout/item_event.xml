<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    card_view:cardCornerRadius="12dp"
    card_view:cardElevation="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:foreground="?android:attr/selectableItemBackground">

        <TextView
            android:id="@+id/tvTituloEvento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Título do Evento"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDataHoraInicio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Início: 01/01/2025 às 09:00"
            android:textColor="#444444"
            android:textSize="14sp"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/tvDataHoraTermino"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Término: 01/01/2025 às 12:00"
            android:textColor="#444444"
            android:textSize="14sp"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tvLocalEvento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Local do Evento"
            android:textColor="#666"
            android:textSize="14sp"
            android:layout_marginTop="2dp" />
        <TextView
            android:id="@+id/tvQuantidade"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quantidade:"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />


    </LinearLayout>

</androidx.cardview.widget.CardView>

